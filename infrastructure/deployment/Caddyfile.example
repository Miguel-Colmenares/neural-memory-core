# Ejemplo de proxy inverso con HTTPS automático (Caddy 2).
# Sustituye los dominios por los tuyos y apunta sus registros DNS al servidor.
# Ver docs/user_guide/despliegue.md.

memoria.ejemplo.com {
    reverse_proxy 127.0.0.1:3000
}

api.memoria.ejemplo.com {
    request_body {
        max_size 25MB
    }
    reverse_proxy 127.0.0.1:8000
}

# Copia este archivo a ".env" y rellena los valores. El archivo .env NUNCA se sube a Git.

# ----------------------------------------------------------------- Base de datos
POSTGRES_USER=nmc
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=nmc
# Con Docker Compose no hace falta tocar NMC_DATABASE_URL (se construye sola).
# Para ejecutar la API fuera de Docker:
# NMC_DATABASE_URL=postgresql+psycopg://nmc:cambia-esta-contraseña@localhost:5432/nmc

# --------------------------------------------------------------------- Seguridad
# Obligatoria, mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NMC_SECRET_KEY=
# Primer usuario administrador: se crea solo si la base aún no tiene usuarios.
# Mínimo 10 caracteres. Después puedes borrar estas dos líneas.
NMC_ADMIN_USERNAME=admin
NMC_ADMIN_PASSWORD=
NMC_ACCESS_TOKEN_MINUTES=720
# Orígenes del panel web autorizados a llamar a la API (separados por comas).
NMC_CORS_ORIGINS=http://localhost:3000
NMC_ENVIRONMENT=development
NMC_LOG_LEVEL=INFO

# -------------------------------------------------------------------- Embeddings
# hashing   -> local, sin descargas ni costo. Parecido léxico; no entiende sinónimos.
# fastembed -> modelo multilingüe local y gratuito (descarga ~220 MB la primera vez).
#              Búsqueda por significado real. Requiere la imagen/instalación con el
#              extra "local-embeddings" (ver docs/architecture/embeddings.md).
# openai    -> API compatible con OpenAI. ATENCIÓN: puede tener costo y envía el texto
#              de tus recuerdos al proveedor.
NMC_EMBEDDING_PROVIDER=hashing
NMC_EMBEDDING_MODEL=
NMC_EMBEDDING_API_BASE=https://api.openai.com/v1
NMC_EMBEDDING_API_KEY=

# ------------------------------------------- Modelo de lenguaje (opcional, RAG)
# none   -> respuestas extractivas (citas literales). Sin costo.
# openai -> API compatible con OpenAI (OpenAI, Ollama, LM Studio, OpenRouter...).
#           ATENCIÓN: un proveedor en la nube puede tener costo.
NMC_LLM_PROVIDER=none
NMC_LLM_MODEL=
NMC_LLM_API_BASE=https://api.openai.com/v1
NMC_LLM_API_KEY=

# ----------------------------------------------------------------------- Módulos
NMC_ENABLED_MODULES=personal,projects,conversations,documents,knowledge,tasks

# ---------------------------------------------------------------------- Panel web
# URL de la API tal como la ve el navegador.
NEXT_PUBLIC_API_URL=http://localhost:8000
